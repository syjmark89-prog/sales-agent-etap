<!DOCTYPE html>
<html lang="en" class="h-full scroll-smooth dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Marcus Vance | Senior Sales Specialist & Digital Card</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- QRCode.js library for dynamic QR code generation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        gold: {
                            400: '#facc15',
                            500: '#eab308',
                            600: '#ca8a04',
                        },
                        glass: {
                            card: 'rgba(15, 23, 42, 0.75)',
                            border: 'rgba(255, 255, 255, 0.12)',
                            input: 'rgba(30, 41, 59, 0.7)',
                            hover: 'rgba(255, 255, 255, 0.08)'
                        },
                        whatsapp: '#25D366',
                        facebook: '#1877F2'
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    boxShadow: {
                        'glass-glow': '0 0 30px -5px rgba(16, 185, 129, 0.15)',
                        'gold-glow': '0 0 25px -5px rgba(234, 179, 8, 0.25)'
                    }
                }
            }
        }
    </script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #030712;
            color: #f3f4f6;
        }

        .glass-panel {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .glass-pill {
            background: rgba(30, 41, 59, 0.6);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .editable-field:hover {
            outline: 2px dashed #ca8a04;
            cursor: pointer;
            border-radius: 4px;
        }

        .editable-active {
            outline: 2px dashed #facc15 !important;
            background: rgba(234, 179, 8, 0.1) !important;
        }

        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        @keyframes pulseGlow {
            0%, 100% { opacity: 0.4; }
            50% { opacity: 0.8; }
        }
        .glow-bg {
            animation: pulseGlow 8s infinite ease-in-out;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col relative overflow-x-hidden pb-20 md:pb-8">

    <div class="fixed top-0 left-1/4 w-96 h-96 bg-emerald-600/20 rounded-full blur-3xl pointer-events-none -z-10 glow-bg"></div>
    <div class="fixed bottom-10 right-10 w-96 h-96 bg-amber-500/15 rounded-full blur-3xl pointer-events-none -z-10 glow-bg" style="animation-delay: 4s;"></div>

    <header class="sticky top-0 z-40 glass-panel border-b border-white/10 px-4 py-3">
        <div class="max-w-4xl mx-auto flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-amber-500 to-emerald-500 flex items-center justify-center text-slate-950 font-black shadow-lg">
                    <i data-lucide="shield-check" class="w-5 h-5"></i>
                </div>
                <div>
                    <span id="agentCompanyText" class="font-bold text-sm text-slate-100 block tracking-tight">APEX LUXURY REALTY</span>
                    <span class="text-[10px] text-emerald-400 font-semibold flex items-center gap-1">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> NFC Digital Card Active
                    </span>
                </div>
            </div>

            <div class="flex items-center space-x-2 sm:space-x-3">
                <!-- Toggle Live Edit Mode -->
                <button onclick="toggleEditMode()" id="editToggleBtn" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30 hover:bg-amber-500/30 transition">
                    <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                    <span id="editToggleText" class="hidden sm:inline">Edit Details</span>
                </button>

                <!-- NFC Hosting / Public Access Guide Modal Trigger -->
                <button onclick="openModal('nfcModal')" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 hover:bg-emerald-500/30 transition">
                    <i data-lucide="wifi" class="w-3.5 h-3.5"></i>
                    <span class="hidden sm:inline">NFC Setup</span>
                </button>

                <!-- QR Code Modal Trigger -->
                <button onclick="showQRCodeModal()" class="p-2 rounded-xl bg-white/10 hover:bg-white/20 text-white transition" title="Show QR Code">
                    <i data-lucide="qr-code" class="w-4 h-4"></i>
                </button>

                <!-- Download vCard -->
                <button onclick="downloadVCard()" class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-bold bg-white text-slate-950 hover:bg-slate-200 transition shadow-md">
                    <i data-lucide="contact" class="w-3.5 h-3.5"></i>
                    <span>Save Contact</span>
                </button>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-4xl w-full mx-auto px-4 py-6 space-y-6">

        <!-- Banner & Hero Card -->
        <div class="glass-panel rounded-3xl overflow-hidden shadow-2xl relative">
